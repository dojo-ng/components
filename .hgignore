syntax: glob

# Dependencies and build output (mirrors .gitignore).
# hg glob patterns are unrooted, so these match at any depth in the monorepo.
node_modules
dist
*.tsbuildinfo
coverage

# macOS system files (Finder/Spotlight cruft that gets injected into the tree)
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems

# caches (Python loves to create these)
__pycache__

# Editor / IDE local files
.idea
.vscode
*.swp
*.swo
*~

# Logs and debug output
npm-debug.log*
*.log

# other local stuff
deploy

# The Enterprise overlay is cloned into this working tree at components/enterprise/
# (see enterprise-repo-split.md) and must NEVER reach this public repository. Rooted
# regexp rather than the glob syntax above: a bare `enterprise` glob is unrooted and
# would also ignore any package that happens to contain a directory of that name.
syntax: regexp
^enterprise/
