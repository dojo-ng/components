{
  "name": "@dojo-ng/components",
  "private": true,
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "description": "Dojo NG web components",
  "type": "module",
  "workspaces": [
    "packages/*",
    "enterprise/packages/*"
  ],
  "customElements": "custom-elements.json",
  "overrides": {
    "errorstacks": "2.4.1"
  },
  "scripts": {
    "build": "tsc -b .",
    "clean": "tsc -b --clean .",
    "cem": "python3 gencem.py",
    "types": "python3 gentypes.py",
    "manifest": "python3 gencem.py && python3 gentypes.py",
    "docs": "python3 gendocs.py && python3 genreadmes.py",
    "catalog": "python3 gencatalog.py",
    "check-drift": "python3 check_drift.py",
    "serve": "python3 -m http.server 8080 --bind 0.0.0.0",
    "start": "npm run build && npm run serve",
    "changeset": "changeset",
    "lint": "eslint packages/*/src tests && python3 direction_lint.py",
    "leak-gate": "python3 leak_gate.py",
    "version-packages": "changeset version && python3 genversions.py",
    "release": "npm run build && changeset publish",
    "test:generators": "python3 -m unittest discover -s tests/generators -p \"test_*.py\"",
    "test:unit": "vitest run",
    "test:browser": "web-test-runner",
    "bench:components": "web-test-runner --config web-test-runner.bench.config.mjs",
    "test": "node --conditions=browser --test tests/*.test.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-commands": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "axe-core": "^4.12.1",
    "eslint": "^10.6.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "happy-dom": "^15.11.0",
    "solid-js": "^1.9.13",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.39"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
