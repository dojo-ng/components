		"expected": [
			{
				"kind": "insertion",
				"start": 0,
				"end": 17,
				"text": "a {--b--} c",
				"spansBlock": false,
				"nested": true
			},
			{
				"kind": "deletion",
				"start": 5,
				"end": 12,
				"text": "b",
				"spansBlock": false,
				"nested": false
			}
		]
